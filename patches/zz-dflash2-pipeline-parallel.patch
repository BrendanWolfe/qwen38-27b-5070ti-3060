     def set_aux_hidden_state_layers(self, layers: tuple[int, ...]) -> None:
         self.model.aux_hidden_state_layers = layers
+        # Non-first PP ranks need persistent receive buffers for every
+        # auxiliary state captured before their stage boundary. The runner
+        # calls this before allocating its IntermediateTensors buffer.
+        num_incoming_aux = sum(
+            layer_idx <= self.model.start_layer for layer_idx in layers
+        )
+        names = ["hidden_states", "residual"] + [
+            f"aux_hidden_state_{i}" for i in range(num_incoming_aux)
+        ]
+        factory = make_empty_intermediate_tensors_factory(
+            names, self.config.hidden_size
+        )
+        self.model.make_empty_intermediate_tensors = factory
+        self.make_empty_intermediate_tensors = factory
 
     def get_eagle3_aux_hidden_state_layers(self) -> tuple[int, ...]:
         num_layers = len(self.model.layers)
